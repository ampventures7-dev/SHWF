# ============================================================================
# Environment Variables Configuration Template (.env.example)
# Copy this file to .env and fill in your Supabase credentials
# ============================================================================

# Supabase Credentials (from your Supabase Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Application Settings
APP_NAME="Student Health Welfare Foundation - Data Ingestion"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8001

# Batch Ingestion Batch Size
BATCH_SIZE=500

# ============================================================================
# Phase 2: Authentication, Security & MSG91 OTP Configuration
# ============================================================================
# JWT Settings (Change JWT_SECRET in production! Use a 32+ char random string)
JWT_SECRET=change-this-to-a-very-secure-random-32-character-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30

# OTP Verification Rules
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX_REQUESTS=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# MSG91 SMS Provider Credentials
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=SHWFPL
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
